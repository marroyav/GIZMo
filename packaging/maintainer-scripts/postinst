#!/bin/sh
set -eu

if command -v systemd-sysusers >/dev/null 2>&1; then
    systemd-sysusers /usr/lib/sysusers.d/gizmo.conf
fi

if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/gizmo.conf
fi

if [ ! -e /var/lib/gizmo/config.bin ] && [ -r /usr/share/gizmo/default-state/config.bin.base64 ]; then
    base64 -d /usr/share/gizmo/default-state/config.bin.base64 > /var/lib/gizmo/config.bin
    chown root:gizmo /var/lib/gizmo/config.bin
    chmod 0664 /var/lib/gizmo/config.bin
fi

if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable --now systemd-timesyncd.service >/dev/null 2>&1 || true
    # Releases before 0.5.0 stopped the complete target in prerm.  Honor that
    # old marker once when crossing the boundary, then use the narrower path
    # for subsequent upgrades.
    if [ -e /run/gizmo/restart-after-upgrade ]; then
        rm -f /run/gizmo/restart-after-upgrade
        systemctl start gizmo.target
    elif [ -e /run/gizmo/restart-services-after-upgrade ]; then
        rm -f /run/gizmo/restart-services-after-upgrade
        systemctl try-restart \
            gizmo-control.service \
            gizmo-zmon.service \
            gizmo-display.service \
            gizmo-temperature.service \
            gizmo-sdr.service \
            gizmo-zmq.service \
            gizmo-opcua.service \
            gizmo-historian.service \
            gizmo-dashboard.service
    fi
fi

echo "gizmo-runtime installed; run 'gizmo-doctor' before enabling gizmo.target"
