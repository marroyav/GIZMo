[Unit]
Description=GIZMo ZeroMQ command service
Requires=gizmo-zmon.service gizmo-control.socket
After=gizmo-zmon.service gizmo-control.socket
PartOf=gizmo.target

[Service]
Type=simple
User=gizmo
Group=gizmo
UMask=0002
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/gizmo/runtime.env
ExecStart=/usr/bin/python3 /usr/libexec/gizmo/gizmo_zmq.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/gizmo
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=yes
LockPersonality=yes

[Install]
WantedBy=gizmo.target
