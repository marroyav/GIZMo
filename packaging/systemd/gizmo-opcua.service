[Unit]
Description=GIZMo OPC-UA bridge
Requires=gizmo-zmq.service gizmo-temperature.service gizmo-sdr.service
After=gizmo-zmq.service gizmo-temperature.service gizmo-sdr.service
PartOf=gizmo.target

[Service]
Type=simple
User=gizmo
Group=gizmo
UMask=0002
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/gizmo/runtime.env
ExecStart=/usr/bin/python3 /usr/libexec/gizmo/gizmo_opcua.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/gizmo
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryDenyWriteExecute=yes
LockPersonality=yes

[Install]
WantedBy=gizmo.target
