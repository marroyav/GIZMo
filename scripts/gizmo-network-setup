#!/bin/sh
set -eu

config_file=${GIZMO_NETWORK_CONFIG:-/etc/gizmo/network.env}
if [ -r "$config_file" ]; then
    . "$config_file"
fi

: "${GIZMO_NETWORK_MODE:=none}"
: "${GIZMO_PS0_INTERFACE:=eth0}"
: "${GIZMO_PS0_ADDRESS:=}"
: "${GIZMO_PS1_INTERFACE:=eth1}"
: "${GIZMO_PS1_ADDRESS:=}"
: "${GIZMO_DEFAULT_GATEWAY:=}"

validate_interface()
{
    case "$1" in
        ''|*[!A-Za-z0-9_.:-]*)
            echo "Invalid interface name: $1" >&2
            return 1
            ;;
    esac
    if [ ! -d "/sys/class/net/$1" ]; then
        echo "Network interface does not exist: $1" >&2
        return 1
    fi
}

configure_static_interface()
{
    interface=$1
    address=$2
    validate_interface "$interface"
    ip link set dev "$interface" up
    ip -4 address flush dev "$interface" scope global
    ip address add "$address" dev "$interface"
}

validate_static_configuration()
{
    if [ -z "$GIZMO_PS0_ADDRESS" ] || [ -z "$GIZMO_PS1_ADDRESS" ]; then
        echo "Static mode requires site-assigned PS0 and PS1 addresses" >&2
        return 1
    fi
    case "$GIZMO_PS0_ADDRESS $GIZMO_PS1_ADDRESS $GIZMO_DEFAULT_GATEWAY" in
        *192.0.2.*|*198.51.100.*|*203.0.113.*|*example.invalid*|*'<'*|*'>'*)
            echo "Refusing documentation placeholder network values" >&2
            return 1
            ;;
    esac
}

case "$GIZMO_NETWORK_MODE" in
    none)
        echo "Network configuration is externally managed"
        exit 0
        ;;
    networkmanager)
        command -v nmcli >/dev/null 2>&1 || {
            echo "NetworkManager mode selected but nmcli is unavailable" >&2
            exit 1
        }
        nmcli -t general status
        echo "NetworkManager owns the PS interfaces"
        exit 0
        ;;
    static)
        validate_static_configuration
        configure_static_interface "$GIZMO_PS0_INTERFACE" "$GIZMO_PS0_ADDRESS"
        configure_static_interface "$GIZMO_PS1_INTERFACE" "$GIZMO_PS1_ADDRESS"
        if [ -n "$GIZMO_DEFAULT_GATEWAY" ]; then
            ip route replace default via "$GIZMO_DEFAULT_GATEWAY" dev "$GIZMO_PS0_INTERFACE"
        fi
        ;;
    *)
        echo "Unsupported GIZMO_NETWORK_MODE: $GIZMO_NETWORK_MODE" >&2
        exit 1
        ;;
esac

ip -brief address show dev "$GIZMO_PS0_INTERFACE"
ip -brief address show dev "$GIZMO_PS1_INTERFACE"
