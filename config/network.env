# static: package owns both PS-port addresses
# networkmanager: NetworkManager owns both ports
# none: another component owns all network configuration
GIZMO_NETWORK_MODE=static

# Only the two Processing System (PS) ports are functional in this release.
GIZMO_PS0_INTERFACE=eth0
GIZMO_PS0_ADDRESS=<redacted-private-ip>/24
GIZMO_PS1_INTERFACE=eth1
GIZMO_PS1_ADDRESS=<redacted-private-ip>/24
GIZMO_DEFAULT_GATEWAY=<redacted-private-ip>
