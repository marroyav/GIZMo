GIZMO_STATE_DIR=/var/lib/gizmo
GIZMO_CONTROL_SOCKET=/run/gizmo/control.sock
PYTHONPATH=/usr/lib/gizmo/python:/usr/libexec/gizmo
PYTHONNOUSERSITE=1

GIZMO_ZMON_HOST=127.0.0.1
GIZMO_ZMON_PORT=5055
GIZMO_ZMQ_ENDPOINT=tcp://*:5555
GIZMO_ZMQ_CLIENT_ENDPOINT=tcp://127.0.0.1:5555

GIZMO_I2C_BUS=7
GIZMO_MCP9808_ADDRESS=0x18
GIZMO_TEMPERATURE_HOST=0.0.0.0
GIZMO_TEMPERATURE_CLIENT_HOST=127.0.0.1
GIZMO_TEMPERATURE_PORT=5005

GIZMO_ADC_BRAM_ADDRESS=0xA0042000
GIZMO_SDR_HOST=0.0.0.0
GIZMO_SDR_CLIENT_HOST=127.0.0.1
GIZMO_SDR_PORT=5556
GIZMO_SDR_SAMPLE_COUNT=2048
GIZMO_SDR_SEND_INTERVAL=0.005

GIZMO_OPCUA_ENDPOINT=opc.tcp://0.0.0.0:4840
GIZMO_BRIDGE_TIMEOUT_MS=3000

# The OPC UA server is the single public monitoring and control contract.
# Fail closed until the controlled site workflow installs certificate material
# and trust/authorization policy. An explicitly approved isolated test may set
# this to 1 temporarily; never expose that mode beyond the restricted bench.
GIZMO_OPCUA_ALLOW_INSECURE=0
GIZMO_OPCUA_CERTIFICATE=
GIZMO_OPCUA_PRIVATE_KEY=
# Monitoring is anonymous/read-only. Mutations remain disabled until a
# credential file and an explicitly reviewed command-gate mode are installed.
GIZMO_OPCUA_COMMAND_GATE=disabled
GIZMO_OPCUA_CREDENTIAL_FILE=/etc/gizmo/opcua-users
GIZMO_OPCUA_ALLOW_INSECURE_CREDENTIALS=0
GIZMO_OPCUA_COMMAND_STATE_FILE=/var/lib/gizmo/opcua-command-state.json
GIZMO_OPCUA_COMMAND_TIMEOUT_SECONDS=60
GIZMO_OPCUA_RESTORE_TIMEOUT_SECONDS=90
GIZMO_OPCUA_CALIBRATION_TIMEOUT_SECONDS=1800
GIZMO_OPCUA_ADC_MAX_BYTES=16777216
GIZMO_OPCUA_MEASUREMENT_INTERVAL=1
GIZMO_OPCUA_PLATFORM_INTERVAL=10
GIZMO_OPCUA_INVENTORY_INTERVAL=30
GIZMO_OPCUA_SDR_INTERVAL=1
GIZMO_EXPECTED_NETWORK_INTERFACES=eth0,eth1
GIZMO_STIMULUS_FREQUENCY_HZ=1436

# Read-only browser dashboard. It uses one local OPC UA subscription and
# republishes cached typed values to browsers; it exposes no write endpoint.
GIZMO_DASHBOARD_OPCUA_ENDPOINT=opc.tcp://127.0.0.1:4840
GIZMO_DASHBOARD_BIND=0.0.0.0
GIZMO_DASHBOARD_PORT=8080
GIZMO_DASHBOARD_SUBSCRIPTION_MS=500
GIZMO_DASHBOARD_PUBLISH_INTERVAL_SECONDS=1
GIZMO_DASHBOARD_HISTORIAN_SOCKET=/run/gizmo/historian.sock

# Persistent, read-only history backing the dashboard's History mode. Raw SDR
# frames are deliberately excluded. Retention runs under a free-space guard.
GIZMO_HISTORIAN_OPCUA_ENDPOINT=opc.tcp://127.0.0.1:4840
GIZMO_HISTORIAN_DATABASE=/var/lib/gizmo/history/gizmo-history.sqlite3
GIZMO_HISTORIAN_SOCKET=/run/gizmo/historian.sock
GIZMO_HISTORIAN_SUBSCRIPTION_MS=500
GIZMO_HISTORIAN_CAPTURE_INTERVAL_SECONDS=1
GIZMO_HISTORIAN_PLATFORM_INTERVAL_SECONDS=10
GIZMO_HISTORIAN_RAW_RETENTION_DAYS=14
GIZMO_HISTORIAN_PLATFORM_RETENTION_DAYS=30
GIZMO_HISTORIAN_ROLLUP_RETENTION_DAYS=365
GIZMO_HISTORIAN_EVENT_RETENTION_DAYS=1825
GIZMO_HISTORIAN_RETENTION_ENABLED=1
GIZMO_HISTORIAN_MIN_FREE_BYTES=2147483648
GIZMO_HISTORIAN_MAX_QUERY_POINTS=5000
GIZMO_HISTORIAN_MAX_EXPORT_ROWS=100000

# Internal compatibility value emitted by the recovered ZMon calculation.
# The display and canonical OPC UA model must never present it as ohms.
GIZMO_RESISTANCE_OVER_RANGE_SENTINEL=1050
GIZMO_RESISTANCE_SENTINEL_TOLERANCE=0.05
GIZMO_RESISTANCE_VALID_MAX_OHM=500
