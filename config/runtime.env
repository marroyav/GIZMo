GIZMO_STATE_DIR=/var/lib/gizmo
GIZMO_CONTROL_SOCKET=/run/gizmo/control.sock
PYTHONPATH=/usr/lib/gizmo/python:/usr/libexec/gizmo
PYTHONNOUSERSITE=1

GIZMO_ZMON_HOST=127.0.0.1
GIZMO_ZMON_PORT=5055
GIZMO_ZMQ_ENDPOINT=tcp://*:5555
GIZMO_ZMQ_CLIENT_ENDPOINT=tcp://127.0.0.1:5555

GIZMO_I2C_BUS=7
GIZMO_MCP9808_ADDRESS=0x18
GIZMO_TEMPERATURE_HOST=0.0.0.0
GIZMO_TEMPERATURE_CLIENT_HOST=127.0.0.1
GIZMO_TEMPERATURE_PORT=5005

GIZMO_ADC_BRAM_ADDRESS=0xA0042000
GIZMO_SDR_HOST=0.0.0.0
GIZMO_SDR_CLIENT_HOST=127.0.0.1
GIZMO_SDR_PORT=5556
GIZMO_SDR_SAMPLE_COUNT=2048
GIZMO_SDR_SEND_INTERVAL=0.005

GIZMO_OPCUA_ENDPOINT=opc.tcp://0.0.0.0:4840
GIZMO_BRIDGE_TIMEOUT_MS=3000

# The OPC UA server is the single public monitoring and control contract.
# Keep insecure/anonymous access only while this instrument is isolated on the
# controls network. Certificate mode also requires the optional cryptography
# runtime plus a site trust/authorization policy; do not expose this endpoint
# merely by changing these three settings.
GIZMO_OPCUA_ALLOW_INSECURE=1
GIZMO_OPCUA_CERTIFICATE=
GIZMO_OPCUA_PRIVATE_KEY=
GIZMO_OPCUA_MEASUREMENT_INTERVAL=1
GIZMO_OPCUA_PLATFORM_INTERVAL=10
GIZMO_OPCUA_INVENTORY_INTERVAL=30
GIZMO_OPCUA_SDR_INTERVAL=1
GIZMO_EXPECTED_NETWORK_INTERFACES=eth0,eth1
GIZMO_STIMULUS_FREQUENCY_HZ=1436
# Internal compatibility value emitted by the recovered ZMon calculation.
# The display and canonical OPC UA model must never present it as ohms.
GIZMO_RESISTANCE_OVER_RANGE_SENTINEL=1050
GIZMO_RESISTANCE_SENTINEL_TOLERANCE=0.05
GIZMO_RESISTANCE_VALID_MAX_OHM=500
