GIZMO_STATE_DIR=/var/lib/gizmo
GIZMO_CONTROL_SOCKET=/run/gizmo/control.sock
PYTHONPATH=/usr/lib/gizmo/python:/usr/libexec/gizmo
PYTHONNOUSERSITE=1

GIZMO_ZMON_HOST=127.0.0.1
GIZMO_ZMON_PORT=5055
GIZMO_ZMQ_ENDPOINT=tcp://*:5555
GIZMO_ZMQ_CLIENT_ENDPOINT=tcp://127.0.0.1:5555

GIZMO_I2C_BUS=7
GIZMO_MCP9808_ADDRESS=0x18
GIZMO_TEMPERATURE_HOST=0.0.0.0
GIZMO_TEMPERATURE_CLIENT_HOST=127.0.0.1
GIZMO_TEMPERATURE_PORT=5005

GIZMO_ADC_BRAM_ADDRESS=0xA0042000
GIZMO_SDR_HOST=0.0.0.0
GIZMO_SDR_CLIENT_HOST=127.0.0.1
GIZMO_SDR_PORT=5556
GIZMO_SDR_SAMPLE_COUNT=2048
GIZMO_SDR_SEND_INTERVAL=0.005

GIZMO_OPCUA_ENDPOINT=opc.tcp://0.0.0.0:4840
GIZMO_BRIDGE_TIMEOUT_MS=3000
