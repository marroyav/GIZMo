# Publication-safe example. Copy this file to the controlled site configuration
# and replace every documentation-only address before selecting static mode.
#
# static: package owns both PS-port addresses
# networkmanager: NetworkManager owns both ports
# none: another component owns all network configuration (safe default)
GIZMO_NETWORK_MODE=none

# RFC 5737 documentation networks; these are not deployment defaults.
GIZMO_PS0_INTERFACE=eth0
GIZMO_PS0_ADDRESS=192.0.2.10/24
GIZMO_PS1_INTERFACE=eth1
GIZMO_PS1_ADDRESS=198.51.100.10/24
GIZMO_DEFAULT_GATEWAY=192.0.2.1
