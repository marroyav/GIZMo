# Immutable hardware/overlay policy. This file is owned as a dpkg conffile.
GIZMO_OVERLAY_NAME=GIZMo_Kria_3_7_25

# The recovered release loads the overlay, unloads it, then loads it again.
# Keep this compatibility behavior until the HDL/overlay owner confirms it is unnecessary.
GIZMO_OVERLAY_RELOAD=1
GIZMO_READY_DEVICE=/dev/i2c-6
GIZMO_I2C_DEVICE=/dev/i2c-7
GIZMO_DEVICE_TIMEOUT=120
