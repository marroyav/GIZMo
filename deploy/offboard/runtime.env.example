PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONPATH=/srv/gizmo-monitor/app/src/python

GIZMO_HISTORIAN_OPCUA_ENDPOINT=opc.tcp://127.0.0.1:48453
GIZMO_HISTORIAN_DATABASE=/srv/gizmo-monitor/data/gizmo-history.sqlite3
GIZMO_HISTORIAN_SOCKET=/srv/gizmo-monitor/run/historian.sock
# Mirror the board-local historian so measurements made during a relay or
# server outage are recovered after connectivity returns.
GIZMO_HISTORIAN_REPLICA_URL=http://127.0.0.1:18080/api/history/replication
GIZMO_HISTORIAN_REPLICA_POLL_SECONDS=2
GIZMO_HISTORIAN_REPLICA_BATCH_SIZE=1000
# Pin this after reading `source.id` from the board replication endpoint.
GIZMO_HISTORIAN_REPLICA_SOURCE_ID=
GIZMO_HISTORIAN_SUBSCRIPTION_MS=500
GIZMO_HISTORIAN_CAPTURE_INTERVAL_SECONDS=1
GIZMO_HISTORIAN_PLATFORM_INTERVAL_SECONDS=10
GIZMO_HISTORIAN_RAW_RETENTION_DAYS=14
GIZMO_HISTORIAN_PLATFORM_RETENTION_DAYS=30
GIZMO_HISTORIAN_ROLLUP_RETENTION_DAYS=365
GIZMO_HISTORIAN_EVENT_RETENTION_DAYS=1825
# This example is a permanent server replica. It still fails closed on low
# free space, but it does not prune successfully replicated rows by age.
GIZMO_HISTORIAN_RETENTION_ENABLED=0
GIZMO_HISTORIAN_MIN_FREE_BYTES=2147483648
GIZMO_HISTORIAN_MAX_QUERY_POINTS=5000
GIZMO_HISTORIAN_MAX_EXPORT_ROWS=100000

GIZMO_DASHBOARD_OPCUA_ENDPOINT=opc.tcp://127.0.0.1:48453
GIZMO_DASHBOARD_BIND=127.0.0.1
GIZMO_DASHBOARD_PORT=18081
GIZMO_DASHBOARD_SUBSCRIPTION_MS=500
GIZMO_DASHBOARD_PUBLISH_INTERVAL_SECONDS=1
GIZMO_DASHBOARD_ASSET_ROOT=/srv/gizmo-monitor/app/web/dashboard
GIZMO_DASHBOARD_HISTORIAN_SOCKET=/srv/gizmo-monitor/run/historian.sock
